                  },
                  "quantity": {
                    "type": "number",
                    "example": 2
                  },
                  "isComposed": {
                    "type": "boolean",
                    "example": false
                  },
                  "hasPortionInfo": {
                    "type": "boolean",
                    "example": false
                  },
                  "hasInstructions": {
                    "type": "boolean",
