          "type": "string",
          "example": "42"
        },
        "commandeId": {
          "type": "string",
          "example": "CMD-67890"
        },
        "timestamp": {
          "type": "string",
          "example": "2025-12-07T14:35:00Z"
        },
        "noteCommande": {},
        "produits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "quantite": {
                "type": "number",
                "example": 3
              },
              "nom": {
                "type": "string",
                "example": "Frites"
              },
              "specialInstructions": {
                "type": "string",
                "example": "Bien croustillantes"
              }
            }
          }
        }
      }
    },
    "CommandeAnnulation": {
      "type": "object",
